#!/bin/bash
set -e  # Exit immediately on any error
set -o pipefail  # Ensure pipeline failures propagate

TEST_VAULT="test-docker-credential-1password"
TEST_URL="https://test.example.com"
TEST_USERNAME="testuser"
TEST_PASSWORD="testpassword"

# Cleanup function to delete the vault on exit
cleanup() {
    echo "Cleaning up: Deleting vault $TEST_VAULT"
    op vault delete "$TEST_VAULT" || echo "Failed to delete vault"
}
trap cleanup EXIT

# Create the test vault
echo "Creating test vault: $TEST_VAULT"
op vault create "$TEST_VAULT" || { echo "Failed to create vault"; exit 1; }

# Get the vault ID and verify retrieval
TEST_VAULT_ID=$(op vault get "$TEST_VAULT" --format=json | jq -r '.id')

if [[ -z "$TEST_VAULT_ID" ]]; then
    echo "Failed to retrieve Vault ID. Check if the vault exists."
    exit 1
fi

echo "Vault created with ID: $TEST_VAULT_ID"

# Set environment variable before using docker-credential-1password
export DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS="$TEST_VAULT_ID"

# Verify if docker-credential-1password recognizes the vault
echo "Running docker-credential-1password list..."
docker-credential-1password list

# 1. Test storing a credential
echo "Storing a test credential..."
echo "{\"ServerURL\": \"$TEST_URL\", \"Username\": \"$TEST_USERNAME\", \"Secret\": \"$TEST_PASSWORD\"}" | docker-credential-1password store

# 2. Test retrieving the credential
echo "Retrieving the stored credential..."
RETRIEVED_CREDENTIAL=$(echo "$TEST_URL" | docker-credential-1password get || echo "FAILED")

if [[ "$RETRIEVED_CREDENTIAL" == "FAILED" ]]; then
    echo "ERROR: Failed to retrieve stored credential!"
    exit 1
else
    echo "Retrieved credential successfully."
    echo "$RETRIEVED_CREDENTIAL" | jq .
fi

# 3. Test listing credentials
echo "Listing stored credentials..."
docker-credential-1password list | jq .

# 4. Test erasing the credential
echo "Erasing the credential..."
echo "$TEST_URL" | docker-credential-1password erase

# 5. Ensure the credential is gone
echo "Verifying that the credential was erased..."
GET_AFTER_ERASE=$(echo "$TEST_URL" | docker-credential-1password get || echo "NOT_FOUND")

if [[ "$GET_AFTER_ERASE" != "NOT_FOUND" ]]; then
    echo "ERROR: Credential was not properly erased!"
    exit 1
else
    echo "Credential successfully erased."
fi

echo "All tests passed!"
