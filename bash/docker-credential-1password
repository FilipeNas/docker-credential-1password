#!/usr/bin/env bash
# NAME
#   docker-credential-1password - docker credential helper for 1 password
# DESCRIPTION
#   Implements the docker credential command line interface. The utility
#   will store and retrieve credentials from specified 1password vaults.
#   store - store the credential as API Credential in the first vault.
#   get   - gets the credential from the vaults by URL.
#   list  - lists all credentials in a readable format with item name and nested objects.
#   erase - removes the credential from all specified vaults.
# PREREQUISITES
#  jq and 1password cli installed.
# ENVIRONMENT
#  DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS - Comma-separated list of 1password vault IDs to use (required)

DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS=""

# Make the script more robust
set -euo pipefail

# Check if vault IDs are set
if [[ -z "${DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS:-}" ]]; then
  echo "ERROR: DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS environment variable must be set" >&2
  exit 1
fi

# Convert comma-separated list to array in a shell-agnostic way
VAULT_IDS=()
IFS=","
for vault_id in $DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS; do
  VAULT_IDS+=("$vault_id")
done
unset IFS

# Find an item by URL (checking hostname field only)
function find_item_by_url() {
  local vault_id="$1"
  local input_url="$2"
  
  # Get all items in the vault
  local items
  if ! items=$(op item list --vault "$vault_id" --format json 2>/dev/null); then
    return 1
  fi
  
  # Check each item's hostname field
  for item_id in $(echo "$items" | jq -r '.[] | .id' 2>/dev/null || echo ""); do
    local item_data
    if ! item_data=$(op item get "$item_id" --vault "$vault_id" --format json 2>/dev/null); then
      continue
    fi
    
    # Check hostname field
    local item_hostname
    item_hostname=$(echo "$item_data" | jq -r '.fields[] | select(.label | ascii_downcase == "hostname") | .value' 2>/dev/null || echo "")
    
    if [[ "$item_hostname" == "$input_url" ]]; then
      echo "$item_id"
      return 0
    fi
  done
  
  return 1
}

function get() {
  local input_url
  input_url=$(cat)
  
  # Iterate through vaults to find the credential
  for vault_id in "${VAULT_IDS[@]}"; do
    local item_id
    if item_id=$(find_item_by_url "$vault_id" "$input_url"); then
      local item_data
      item_data=$(op item get "$item_id" --vault "$vault_id" --format json 2>/dev/null)
      
      # Format the output as JSON
      jq --arg registry "$input_url" '{
        ServerURL: $registry, 
        Username: (.fields[] | select(.id == "username") | .value), 
        Secret: (.fields[] | select(.id == "credential") | .value)
      }' <<< "$item_data" 2>/dev/null || echo "{}"
      return 0
    fi
  done

  return 1
}

function erase() {
  local input_url
  input_url=$(cat)
  
  # Find and delete the item from all vaults if it exists
  for vault_id in "${VAULT_IDS[@]}"; do
    local item_id
    if item_id=$(find_item_by_url "$vault_id" "$input_url"); then
      op item delete "$item_id" --vault "$vault_id" > /dev/null 2>&1 || true
    fi
  done
}

# List function that shows item name with nested Username and URL
function list() {
  local result="{}"
  
  for vault_id in "${VAULT_IDS[@]}"; do
    # Check if vault exists by trying to list items
    local vault_items
    if ! vault_items=$(op item list --vault "$vault_id" --format json 2>/dev/null); then
      continue
    fi
    
    # Process each item in the vault
    local ids
    ids=$(echo "$vault_items" | jq -r '.[] | .id' 2>/dev/null || echo "")
    
    for id in $ids; do
      local item_data
      item_data=$(op item get "$id" --vault "$vault_id" --format json 2>/dev/null)
      if [[ -n "$item_data" ]]; then
        local title username hostname
        title=$(echo "$item_data" | jq -r '.title' 2>/dev/null || echo "")
        username=$(echo "$item_data" | jq -r '.fields[] | select(.id == "username") | .value' 2>/dev/null || echo "")
        hostname=$(echo "$item_data" | jq -r '.fields[] | select(.label | ascii_downcase == "hostname") | .value' 2>/dev/null || echo "")
        
        if [[ -n "$username" && -n "$hostname" ]]; then
          # Create object with username and hostname
          local item_obj
          item_obj=$(jq -n --arg user "$username" --arg url "$hostname" '{Username: $user, URL: $url}')
          
          # Add to the result with hostname as the value and title as the key
          local mapping
          mapping=$(jq -n --arg title "$title" --argjson obj "$item_obj" '{($title): $obj}')
          result=$(echo "$result $mapping" | jq -s 'add')
        fi
      fi
    done
  done
  
  # Output the result
  echo "$result" | jq -r 'if . == null then {} else . end'
}

function store() {
  local body url username credential
  body=$(cat)
  url=$(echo "$body" | jq -r '.ServerURL')
  username=$(echo "$body" | jq -r '.Username')
  credential=$(echo "$body" | jq -r '.Secret')
  
  # Use the first vault in the list for storing
  local primary_vault_id="${VAULT_IDS[0]}"
  
  # First check if an item with this URL already exists
  local existing_id=""
  existing_id=$(find_item_by_url "$primary_vault_id" "$url" || echo "")
  
  if [[ -n "$existing_id" ]]; then
    # Update existing item - only update username and credential
    # This preserves any user-set expiration fields and doesn't update the hostname
    op item edit --format json \
      "$existing_id" \
      --vault "$primary_vault_id" -- \
      "username=$username" \
      "credential=$credential" \
      </dev/null >/dev/null 2>&1
  else
    # Create new item with API Credential category
    local item_json
    item_json=$(op item create --format json \
      --title "$url" \
      --category "API Credential" \
      --vault "$primary_vault_id" -- \
      "username=$username" \
      "credential=$credential" \
      "hostname=$url" \
      </dev/null)
      
    # Get the new item's ID and attempt to remove expiration date fields
    local new_item_id
    new_item_id=$(echo "$item_json" | jq -r '.id')
    op item edit --format json \
      "$new_item_id" \
      --vault "$primary_vault_id" -- \
      "expires[delete]" \
      "validFrom[delete]" \
      </dev/null >/dev/null 2>&1
  fi
}

function check_dependencies() {
  local missing_deps=()
  
  if ! command -v jq >/dev/null 2>&1; then
    missing_deps+=("jq")
  fi
  
  if ! command -v op >/dev/null 2>&1; then
    missing_deps+=("1password CLI (op)")
  fi
  
  if [[ ${#missing_deps[@]} -gt 0 ]]; then
    echo "ERROR: Missing dependencies: ${missing_deps[*]}" >&2
    return 1
  fi
  
  return 0
}

function usage() {
  echo "Usage: docker-credential-1password [get|list|store|erase]" >&2
  echo "" >&2
  echo "Commands:" >&2
  echo "  get     - Gets credentials for a specific server URL" >&2
  echo "  list    - Lists all credentials in a readable format" >&2
  echo "  store   - Stores credentials for a server" >&2
  echo "  erase   - Removes credentials for a server" >&2
  echo "" >&2
  echo "Environment variables:" >&2
  echo "  DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS - Comma-separated list of 1password vault IDs to use (required)" >&2
  exit 1
}

function main() {
  # Check dependencies
  if ! check_dependencies; then
    exit 1
  fi

  # Check if argument is provided
  if [[ $# -eq 0 ]]; then
    usage
  fi

  # Process command
  case "$1" in
    list)
      list
      ;;
    get)
      get
      ;;
    store)
      store
      ;;
    erase)
      erase
      ;;
    *)
      echo "Error: unknown option $1" >&2
      usage
      ;;
  esac
}

main "$@"

