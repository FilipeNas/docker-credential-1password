#!/bin/bash
# NAME
#   docker-credential-1password - docker credential helper for 1 password
# 
# DESCRIPTION
#   Implements the docker credential command line interface. The utility
#   will store all credentials in the specified 1Password vault (by ID or name).
#   
#   store - store the credential as API Credential in the specified vault.
#   get   - gets the credential from the vault by title.
#   list  - lists all credentials and user names in the vault.
#   erase - removes the credential from the vault.
#
# PREREQUISITES
#   jq and 1password CLI installed.
#
# ENVIRONMENT
#   DOCKER_CREDENTIAL_1PASSWORD_VAULT      - name of the 1Password vault to use (default: Docker).
#   DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID  - ID of the 1Password vault to use. Overrides the vault name.

DOCKER_CREDENTIAL_1PASSWORD_VAULT=${DOCKER_CREDENTIAL_1PASSWORD_VAULT:-Docker}
DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID=${DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID:-""}

function get_vault_id {
  # If DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID is set, use it directly
  if [[ -n $DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID ]]; then
    echo "$DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID"
    return 0
  fi

  # Otherwise, resolve the vault ID by name
  result=($(op vault list --format json | \
    jq --arg vault "$DOCKER_CREDENTIAL_1PASSWORD_VAULT" -r 'map(select(.name == $vault) | .id)|.[]'))

  case ${#result[@]} in
    1)
      echo "${result[0]}";;
    0)
      echo "ERROR: Vault name '$DOCKER_CREDENTIAL_1PASSWORD_VAULT' not found in 1Password." >&2
      return 1;;
    *)
      echo "ERROR: Multiple vaults with name '$DOCKER_CREDENTIAL_1PASSWORD_VAULT' found in 1Password." >&2
      return 2;;
  esac
}

function get {
  registry=$(</dev/stdin)
  vault_id=$(get_vault_id) || return $?

  credentials=$(op item get "$registry" \
                --vault "$vault_id" --format json 2>/dev/null)

  [[ -z $credentials ]] && return 1

  jq --arg registry "$registry" '{
    ServerURL: $registry,
    Username: (.fields | map(select(.id == "username") | .value) | .[0]),
    Secret: (.fields | map(select(.id == "credential") | .value) | .[0])
  }' <<< "$credentials"
}

function erase {
  registry=$(</dev/stdin)
  vault_id=$(get_vault_id) || return $?

  item=$(op item get "$registry" --vault "$vault_id" --format json 2>/dev/null)
  if [[ -n $item ]]; then
    op item delete $(jq -r .id <<< "$item") --vault "$vault_id" > /dev/null
  fi
}

function list {
  vault_id=$(get_vault_id) || return $?

  op item list --vault "$vault_id" --format json | \
    jq -r 'map(.id)|.[]' | \
  while read id; do
    op item get "$id" --format json | \
    jq '{(.title | sub("^"; "https://")): (.fields | map(select(.id == "username") | .value) | .[0]) }'
  done | jq -rs add | jq -r 'if(. != null) then . else {} end'
}

function store {
  body=$(</dev/stdin)
  url=$(jq -r '.ServerURL' <<< "$body")
  username=$(jq -r '.Username' <<< "$body")
  credential=$(jq -r '.Secret' <<< "$body")

  vault_id=$(get_vault_id) || return $?

  items=($(op item list --vault "$vault_id" --format json | \
          jq -r --arg title "$url" 'map(select(.title == $title) | .id) | .[]'))
  if [[ ${#items[@]} -eq 0 ]]; then
    op item create --format json \
      --title "$url" --category "API Credential" \
      --vault "$vault_id" -- \
      "username=$username" \
      "credential=$credential" \
      "valid from=$(date +%s)" \
      "expires=2147483647" \
      </dev/null >/dev/null
  else
    op item edit --format json \
      "${items[0]}" \
      --vault "$vault_id" -- \
      "username=$username" \
      "credential=$credential" \
      "valid from=$(date +%s)" \
      "expires=2147483647" \
      </dev/null >/dev/null
  fi
}

function usage {
  echo "Usage: docker-credential-1password [get|list|store|erase]" >&2
  echo "$@" >&2
  exit 1
}

function main {
  if ! which jq >/dev/null 2>&1; then
    usage "missing jq on PATH"
  fi
  if ! which op >/dev/null 2>&1; then
    usage "missing 1password CLI (op) on PATH"
  fi

  case $1 in
    list|get|store|erase)
      eval "$1";;
    *)
      usage "unknown option $1"
  esac
}

main "$@"
