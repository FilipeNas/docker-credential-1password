#!/bin/bash
# NAME
#   docker-credential-1password - docker credential helper for 1 password
# 
# DESCRIPTION
#   Implements the docker credential command line interface. The utility
#   will store all credentials in the 1password 'Docker' vault. If the
#   vault does not exist, it will be created.
#   
#   store - store the credential as API Credential in the Docker vault.
#           Creates the Docker vault if it does not exist.
#   get   - gets the credential from the Docker vault by title.
#   list  - lists all credentials and user names in the Docker vault.
#   erase - removes the credential from the Docker vault.
#
# PREREQUISITES
#  jq and 1password cli installed.
#
# ENVIRONMENT
#  DOCKER_CREDENTIAL_1PASSWORD_VAULT_NAME - name of the 1password vault to use, default Docker
#  DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID - ID of the 1password vault to use, takes precedence over name

set -eo pipefail

# Default vault name is "Docker" if not specified
DOCKER_CREDENTIAL_1PASSWORD_VAULT_NAME=${DOCKER_CREDENTIAL_1PASSWORD_VAULT_NAME:-Docker}
DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID=${DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID:-}

function resolve_vault_id() {
  # If VAULT_ID is set, use it directly
  if [[ -n "$DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID" ]]; then
    echo "$DOCKER_CREDENTIAL_1PASSWORD_VAULT_ID"
    return 0
  fi

  # Otherwise, look up the ID by name
  local vault_ids
  vault_ids=$(op vault list --format json | jq --arg vault "$DOCKER_CREDENTIAL_1PASSWORD_VAULT_NAME" -r 'map(select(.name == $vault) | .id)|.[]')
  
  # Convert to array
  readarray -t result <<< "$vault_ids"
  
  case ${#result[@]} in
    1)
      echo "${result[0]}"
      return 0
      ;;
    0)
      return 1
      ;;
    *)
      echo "ERROR: multiple '$DOCKER_CREDENTIAL_1PASSWORD_VAULT_NAME' vaults found in 1Password" >&2
      return 2
      ;;
  esac
}

function get() {
  local registry vault_id credentials
  
  registry=$(</dev/stdin)
  vault_id=$(resolve_vault_id) || return 0
  
  credentials=$(op item get "$registry" --vault "$vault_id" --format json 2>/dev/null) || return 1
  
  jq --arg registry "$registry" '{
    ServerURL: $registry, 
    Username: (.fields|map(select(.id == "username")|.value)|.[0]), 
    Secret: (.fields|map(select(.id == "credential")|.value)|.[0])
  }' <<< "$credentials"
}

function erase() {
  local registry vault_id item item_id
  
  registry=$(</dev/stdin)
  vault_id=$(resolve_vault_id) || return 0
  
  item=$(op item get "$registry" --vault "$vault_id" --format json 2>/dev/null) || return 0
  
  if [[ -n "$item" ]]; then
    item_id=$(jq -r .id <<< "$item")
    op item delete "$item_id" --vault "$vault_id" > /dev/null
  fi
}

function list() {
  local vault_id exit_code result
  
  vault_id=$(resolve_vault_id)
  exit_code=$?
  
  if [[ -z "$vault_id" && "$exit_code" -eq 1 ]]; then
    echo '{}'
    return 0
  elif [[ -z "$vault_id" ]]; then
    return 1
  fi
  
  result=$(op item list --vault "$vault_id" --format json | 
    jq -r 'map(.id)|.[]' | 
    while read -r id; do
      op item get "$id" --format json | 
      jq '{(.title | sub("^";"https://")): (.fields|map(select(.id == "username")|.value)|.[0]) }'
    done | jq -rs add)
  
  echo "${result:-{}}"
}

function store() {
  local body url username credential vault_id exit_code items
  
  body=$(</dev/stdin)
  url=$(jq -r '.ServerURL' <<< "$body")
  username=$(jq -r '.Username' <<< "$body")
  credential=$(jq -r '.Secret' <<< "$body")
  
  vault_id=$(resolve_vault_id)
  exit_code=$?
  
  if [[ -z "$vault_id" && "$exit_code" -eq 1 ]]; then
    # Create vault if it doesn't exist
    vault_id=$(op vault create --format json "$DOCKER_CREDENTIAL_1PASSWORD_VAULT_NAME" </dev/null | jq -r .id)
    if [[ -z "$vault_id" ]]; then
      echo "ERROR: failed to create Vault '$DOCKER_CREDENTIAL_1PASSWORD_VAULT_NAME'" >&2
      return 1
    fi
  elif [[ -z "$vault_id" ]]; then
    return 1
  fi
  
  # Check if item already exists
  readarray -t items < <(op item list --vault "$vault_id" --format json | 
                        jq -r --arg title "$url" 'map(select(.title == $title)|.id)|.[]')
  
  if [[ ${#items[@]} -eq 0 ]]; then
    # Create new item
    op item create --format json \
      --title "$url" --category "API Credential" \
      --vault "$vault_id" -- \
      "username=$username" \
      "credential=$credential" \
      "valid from=$(date +%s)" \
      "expires=2147483647" \
      </dev/null >/dev/null
  else
    # Update existing item
    op item edit --format json \
      "${items[0]}" \
      --vault "$vault_id" -- \
      "username=$username" \
      "credential=$credential" \
      "valid from=$(date +%s)" \
      "expires=2147483647" \
      </dev/null >/dev/null
  fi
}

function check_dependencies() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "ERROR: missing jq on PATH" >&2
    return 1
  fi
  
  if ! command -v op >/dev/null 2>&1; then
    echo "ERROR: missing 1password CLI (op) on PATH" >&2
    return 1
  fi
  
  return 0
}

function usage() {
  echo "Usage: docker-credential-1password [get|list|store|erase]" >&2
  if [[ -n "$1" ]]; then
    echo "$1" >&2
  fi
  exit 1
}

function main() {
  check_dependencies || usage
  
  case "$1" in
    list|get|store|erase)
      "$1"
      ;;
    *)
      usage "Unknown option: $1"
      ;;
  esac
}

main "$@"
