#!/bin/bash
# NAME
#   docker-credential-1password - docker credential helper for 1 password
# 
# DESCRIPTION
#   Implements the docker credential command line interface. The utility
#   will store all credentials in specified 1password vaults.
#   
#   store - store the credential as API Credential in the specified vault.
#   get   - gets the credential from the specified vaults by title.
#   list  - lists all credentials and user names in the specified vaults.
#   erase - removes the credential from the specified vaults.
#
# PREREQUISITES
#  jq and 1password cli installed.
#
# ENVIRONMENT
#  DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS - comma-separated list of 1password vault IDs to use

set -euo pipefail

# Constants
readonly CURRENT_TIME=$(date +%s)
readonly MAX_EXPIRY=2147483647

# Parse vault IDs from environment variable
function get_vault_ids() {
  local ids=()
  
  if [[ -z "${DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS:-}" ]]; then
    echo "ERROR: No vault IDs specified. Set DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS environment variable." >&2
    return 1
  fi
  
  IFS=',' read -ra ids <<< "$DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS"
  printf '%s\n' "${ids[@]}"
}

function get() {
  local registry vault_ids credentials
  
  registry=$(cat)
  
  if ! vault_ids=($(get_vault_ids)); then
    return 1
  fi
  
  for vault_id in "${vault_ids[@]}"; do
    if credentials=$(op item get "$registry" --vault "$vault_id" --format json 2>/dev/null); then
      break
    fi
  done
  
  [[ -z "${credentials:-}" ]] && return 1
  
  jq --arg registry "$registry" '{
    ServerURL: $registry, 
    Username: (.fields|map(select(.id == "username")|.value)|.[0]), 
    Secret: (.fields|map(select(.id == "credential")|.value)|.[0])
  }' <<< "$credentials"
}

function erase() {
  local registry vault_ids item item_id
  
  registry=$(cat)
  
  if ! vault_ids=($(get_vault_ids)); then
    return 1
  fi
  
  for vault_id in "${vault_ids[@]}"; do
    if ! item=$(op item get "$registry" --vault "$vault_id" --format json 2>/dev/null); then
      continue
    fi
    
    item_id=$(jq -r .id <<< "$item")
    op item delete "$item_id" --vault "$vault_id" > /dev/null
  done
}

function list() {
  local vault_ids result combined_result="{}"
  
  if ! vault_ids=($(get_vault_ids)); then
    return 1
  fi
  
  for vault_id in "${vault_ids[@]}"; do
    items_json=$(op item list --vault "$vault_id" --format json)
    
    result=$(jq -r 'map(.id)|.[]' <<< "$items_json" | 
      while read -r id; do
        op item get "$id" --format json | 
        jq '{(.title | sub("^";"https://")): (.fields|map(select(.id == "username")|.value)|.[0]) }'
      done | jq -rs add)
    
    if [[ -n "${result:-}" && "$result" != "null" ]]; then
      combined_result=$(jq -s '.[0] * (.[1] // {})' <<< "$combined_result $result")
    fi
  done
  
  echo "${combined_result}"
}

function store() {
  local body url username credential vault_id
  
  body=$(cat)
  url=$(jq -r '.ServerURL' <<< "$body")
  username=$(jq -r '.Username' <<< "$body")
  credential=$(jq -r '.Secret' <<< "$body")
  
  if ! vault_ids=($(get_vault_ids)); then
    return 1
  fi
  
  primary_vault_id="${vault_ids[0]}"
  
  items_json=$(op item list --vault "$primary_vault_id" --format json)
  item_ids=$(jq -r --arg title "$url" 'map(select(.title == $title)|.id)|.[]' <<< "$items_json")
  
  mapfile -t items <<< "$item_ids"
  
  item_params=(
    "username=$username" 
    "credential=$credential" 
    "valid from=$CURRENT_TIME" 
    "expires=$MAX_EXPIRY"
  )
  
  if [[ ${#items[@]} -eq 0 ]]; then
    op item create --format json \
      --title "$url" --category "API Credential" \
      --vault "$primary_vault_id" -- \
      "${item_params[@]}" \
      </dev/null >/dev/null
  else
    op item edit --format json \
      "${items[0]}" \
      --vault "$primary_vault_id" -- \
      "${item_params[@]}" \
      </dev/null >/dev/null
  fi
}

function check_dependencies() {
  local missing_deps=()
  
  if ! command -v jq >/dev/null 2>&1; then
    missing_deps+=("jq")
  fi
  
  if ! command -v op >/dev/null 2>&1; then
    missing_deps+=("1password CLI (op)")
  fi
  
  if [[ ${#missing_deps[@]} -gt 0 ]]; then
    printf "ERROR: missing dependencies: %s\n" "${missing_deps[*]}" >&2
    return 1
  fi
  
  return 0
}

function usage() {
  printf "Usage: docker-credential-1password [get|list|store|erase]\n" >&2
  if [[ -n "${1:-}" ]]; then
    printf "%s\n" "$1" >&2
  fi
  exit 1
}

function main() {
  if ! check_dependencies; then 
    usage
  fi
  
  case "${1:-}" in
    list|get|store|erase)
      "$1"
      ;;
    *)
      usage "Unknown option: ${1:-}"
      ;;
  esac
}

main "$@"
