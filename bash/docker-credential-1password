#!/usr/bin/env bash
# NAME
#   docker-credential-1password - docker credential helper for 1password
# DESCRIPTION
#   Implements the docker credential command line interface. The utility
#   will store and retrieve credentials from specified 1password vaults.
#   store - store the credential as API Credential in the first vault.
#   get   - gets the credential from the vaults by URL.
#   list  - lists all credentials in a readable format with item name and nested objects.
#   erase - removes the credential from all specified vaults.
# PREREQUISITES
#  jq and 1password cli installed.
# ENVIRONMENT
#  DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS - Comma-separated list of 1password vault IDs to use (required)
#  DOCKER_CREDENTIAL_1PASSWORD_TAG_ENABLED - Enable tag filtering (optional, default: false)
#  DOCKER_CREDENTIAL_1PASSWORD_TAG_NAME - Tag name to filter by (required if tag filtering is enabled)

# Make the script more robust
set -euo pipefail

# Initialize environment variables with defaults
DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS="${DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS:-}"
DOCKER_CREDENTIAL_1PASSWORD_TAG_ENABLED="${DOCKER_CREDENTIAL_1PASSWORD_TAG_ENABLED:-false}"
DOCKER_CREDENTIAL_1PASSWORD_TAG_NAME="${DOCKER_CREDENTIAL_1PASSWORD_TAG_NAME:-}"

# Validate required environment variables
function validate_environment() {
  if [[ -z "${DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS}" ]]; then
    echo "ERROR: DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS environment variable must be set" >&2
    return 1
  fi

  if [[ "${DOCKER_CREDENTIAL_1PASSWORD_TAG_ENABLED}" == "true" && -z "${DOCKER_CREDENTIAL_1PASSWORD_TAG_NAME}" ]]; then
    echo "ERROR: DOCKER_CREDENTIAL_1PASSWORD_TAG_NAME must be set when DOCKER_CREDENTIAL_1PASSWORD_TAG_ENABLED is true" >&2
    return 1
  fi
  
  return 0
}

# Convert comma-separated list to array
function initialize_vault_ids() {
  local vault_list="$1"
  local vault_array=()
  
  IFS="," read -ra vault_array <<< "$vault_list"
  echo "${vault_array[@]}"
}

# Find an item by its hostname field matching the given URL
function find_item_by_hostname() {
  local vault_id="$1"
  local hostname="$2"
  
  # Construct the command to list items
  local items_cmd=("op" "item" "list" "--vault" "$vault_id" "--format" "json")
  if [[ "${DOCKER_CREDENTIAL_1PASSWORD_TAG_ENABLED}" == "true" ]]; then
    items_cmd+=("--tags" "${DOCKER_CREDENTIAL_1PASSWORD_TAG_NAME}")
  fi
  
  # Get items from the vault
  local items
  if ! items=$("${items_cmd[@]}" 2>/dev/null); then
    echo "ERROR: Failed to list items in vault $vault_id" >&2
    return 1
  fi
  
  # Check if items is valid JSON
  if ! jq empty <<< "$items" 2>/dev/null; then
    echo "ERROR: Invalid JSON response from 1Password CLI for vault $vault_id" >&2
    return 1
  fi
  
  # Extract all item IDs from the list
  local item_ids
  item_ids=$(jq -r '.[] | .id' <<< "$items" 2>/dev/null || echo "")
  
  for item_id in $item_ids; do
    local item_data
    if ! item_data=$(op item get "$item_id" --vault "$vault_id" --format json 2>/dev/null); then
      continue
    fi
    
    # Check hostname field
    local item_hostname
    item_hostname=$(jq -r '.fields[] | select(.label | ascii_downcase == "hostname") | .value' <<< "$item_data" 2>/dev/null || echo "")
    
    if [[ "$item_hostname" == "$hostname" ]]; then
      echo "$item_id"
      return 0
    fi
  done
  
  return 1
}

# Get credentials for a specific server URL
function get() {
  # Read server URL from stdin
  local input_url
  if ! input_url=$(cat); then
    echo "ERROR: Failed to read input from stdin" >&2
    return 1
  fi
  
  # Validate the input URL is not empty
  if [[ -z "$input_url" ]]; then
    echo "ERROR: Empty server URL provided" >&2
    return 1
  fi
  
  # Get the vault IDs
  local vault_ids
  vault_ids=($(initialize_vault_ids "$DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS"))
  
  # Iterate through vaults to find the credential
  for vault_id in "${vault_ids[@]}"; do
    local item_id
    if item_id=$(find_item_by_hostname "$vault_id" "$input_url"); then
      local item_data
      if ! item_data=$(op item get "$item_id" --vault "$vault_id" --format json 2>/dev/null); then
        echo "ERROR: Failed to get item data for $item_id in vault $vault_id" >&2
        continue
      fi
      
      # Format the output as JSON
      if ! jq --arg registry "$input_url" '{
        ServerURL: $registry, 
        Username: (.fields[] | select(.id == "username") | .value), 
        Secret: (.fields[] | select(.id == "credential") | .value)
      }' <<< "$item_data" 2>/dev/null; then
        echo "ERROR: Failed to parse item data" >&2
        continue
      fi
      
      return 0
    fi
  done

  echo "ERROR: No credential found for $input_url" >&2
  return 1
}

# Remove credentials for a server
function erase() {
  # Read server URL from stdin
  local input_url
  if ! input_url=$(cat); then
    echo "ERROR: Failed to read input from stdin" >&2
    return 1
  fi
  
  # Validate the input URL is not empty
  if [[ -z "$input_url" ]]; then
    echo "ERROR: Empty server URL provided" >&2
    return 1
  fi
  
  # Get the vault IDs
  local vault_ids
  vault_ids=($(initialize_vault_ids "$DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS"))
  
  # Find and delete the item from all vaults if it exists
  local found=false
  for vault_id in "${vault_ids[@]}"; do
    local item_id
    if item_id=$(find_item_by_hostname "$vault_id" "$input_url"); then
      if op item delete "$item_id" --vault "$vault_id" > /dev/null 2>&1; then
        echo "Deleted credential for $input_url from vault $vault_id"
        found=true
      else
        echo "ERROR: Failed to delete credential for $input_url from vault $vault_id" >&2
      fi
    fi
  done
  
  if [[ "$found" == "false" ]]; then
    echo "WARNING: No credentials found to erase for $input_url" >&2
  fi
}

# List all credentials in a readable format
function list() {
  local result="[]"
  
  # Get the vault IDs
  local vault_ids
  vault_ids=($(initialize_vault_ids "$DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS"))
  
  for vault_id in "${vault_ids[@]}"; do
    # Construct the command to list items
    local items_cmd=("op" "item" "list" "--vault" "$vault_id" "--format" "json")
    if [[ "${DOCKER_CREDENTIAL_1PASSWORD_TAG_ENABLED}" == "true" ]]; then
      items_cmd+=("--tags" "${DOCKER_CREDENTIAL_1PASSWORD_TAG_NAME}")
    fi
    
    # Get items from the vault
    local vault_items
    if ! vault_items=$("${items_cmd[@]}" 2>/dev/null); then
      echo "WARNING: Failed to list items in vault $vault_id" >&2
      continue
    fi
    
    # Validate JSON response
    if ! jq empty <<< "$vault_items" 2>/dev/null; then
      echo "WARNING: Invalid JSON response from 1Password CLI for vault $vault_id" >&2
      continue
    fi
    
    # Extract all item IDs from the list
    local item_ids
    item_ids=$(jq -r '.[] | .id' <<< "$vault_items" 2>/dev/null || echo "")
    
    for item_id in $item_ids; do
      local item_data
      if ! item_data=$(op item get "$item_id" --vault "$vault_id" --format json 2>/dev/null); then
        continue
      fi
      
      # Extract and validate required fields
      local title username hostname
      title=$(jq -r '.title' <<< "$item_data" 2>/dev/null || echo "")
      username=$(jq -r '.fields[] | select(.id == "username") | .value' <<< "$item_data" 2>/dev/null || echo "")
      hostname=$(jq -r '.fields[] | select(.label | ascii_downcase == "hostname") | .value' <<< "$item_data" 2>/dev/null || echo "")
      
      if [[ -n "$username" && -n "$hostname" ]]; then
        # Create object with title, username and hostname
        local item_obj
        if ! item_obj=$(jq -n --arg title "$title" --arg user "$username" --arg url "$hostname" \
          '{Title: $title, Username: $user, URL: $url}'); then
          echo "WARNING: Failed to create JSON object for item $item_id" >&2
          continue
        fi
        
        # Add to the result array
        result=$(jq -s '.[0] + [.[1]]' <<< "$result $item_obj")
      fi
    done
  done
  
  # Output the result
  echo "$result"
}

# Store credentials for a server
function store() {
  # Read JSON input from stdin
  local body
  if ! body=$(cat); then
    echo "ERROR: Failed to read input from stdin" >&2
    return 1
  fi
  
  # Validate JSON input
  if ! jq empty <<< "$body" 2>/dev/null; then
    echo "ERROR: Invalid JSON input" >&2
    return 1
  fi
  
  # Extract required fields
  local url username credential
  url=$(jq -r '.ServerURL' <<< "$body")
  username=$(jq -r '.Username' <<< "$body")
  credential=$(jq -r '.Secret' <<< "$body")
  
  # Validate required fields
  if [[ -z "$url" || "$url" == "null" ]]; then
    echo "ERROR: Missing ServerURL in input" >&2
    return 1
  fi
  
  if [[ -z "$username" || "$username" == "null" ]]; then
    echo "ERROR: Missing Username in input" >&2
    return 1
  fi
  
  if [[ -z "$credential" || "$credential" == "null" ]]; then
    echo "ERROR: Missing Secret in input" >&2
    return 1
  fi
  
  # Get the vault IDs
  local vault_ids
  vault_ids=($(initialize_vault_ids "$DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS"))
  
  # Use the first vault in the list for storing
  local primary_vault_id="${vault_ids[0]}"
  
  # First check if an item with this URL already exists
  local existing_id=""
  existing_id=$(find_item_by_hostname "$primary_vault_id" "$url" || echo "")
  
  if [[ -n "$existing_id" ]]; then
    # Update existing item - only update username and credential
    # This preserves any user-set expiration fields and doesn't update the hostname
    if op item edit --format json \
      "$existing_id" \
      --vault "$primary_vault_id" -- \
      "username=$username" \
      "credential=$credential" \
      </dev/null >/dev/null 2>&1; then
      echo "Updated existing credential for $url"
    else
      echo "ERROR: Failed to update existing credential for $url" >&2
      return 1
    fi
  else
    # Create new item with API Credential category
    local create_cmd=("op" "item" "create" "--format" "json"
      "--title" "$url"
      "--category" "API Credential"
      "--vault" "$primary_vault_id")
    
    # Add tag if tag filtering is enabled
    if [[ "${DOCKER_CREDENTIAL_1PASSWORD_TAG_ENABLED}" == "true" ]]; then
      create_cmd+=("--tags" "${DOCKER_CREDENTIAL_1PASSWORD_TAG_NAME}")
    fi
    
    create_cmd+=("--")
    create_cmd+=("username=$username"
      "credential=$credential"
      "hostname=$url")
    
    local item_json
    if item_json=$("${create_cmd[@]}" </dev/null); then
      echo "Created new credential for $url"
      
      # Get the new item's ID and attempt to remove expiration date fields
      local new_item_id
      new_item_id=$(jq -r '.id' <<< "$item_json")
      
      op item edit --format json \
        "$new_item_id" \
        --vault "$primary_vault_id" -- \
        "expires[delete]" \
        "validFrom[delete]" \
        </dev/null >/dev/null 2>&1
    else
      echo "ERROR: Failed to create new credential for $url" >&2
      return 1
    fi
  fi
}

# Check for required dependencies
function check_dependencies() {
  local missing_deps=()
  
  if ! command -v jq >/dev/null 2>&1; then
    missing_deps+=("jq")
  fi
  
  if ! command -v op >/dev/null 2>&1; then
    missing_deps+=("1password CLI (op)")
  fi
  
  if [[ ${#missing_deps[@]} -gt 0 ]]; then
    echo "ERROR: Missing dependencies: ${missing_deps[*]}" >&2
    return 1
  fi
  
  return 0
}

# Display usage information
function usage() {
  echo "Usage: docker-credential-1password [get|list|store|erase]" >&2
  echo "" >&2
  echo "Commands:" >&2
  echo "  get     - Gets credentials for a specific server URL" >&2
  echo "  list    - Lists all credentials in a readable format" >&2
  echo "  store   - Stores credentials for a server" >&2
  echo "  erase   - Removes credentials for a server" >&2
  echo "" >&2
  echo "Environment variables:" >&2
  echo "  DOCKER_CREDENTIAL_1PASSWORD_VAULT_IDS - Comma-separated list of 1password vault IDs to use (required)" >&2
  echo "  DOCKER_CREDENTIAL_1PASSWORD_TAG_ENABLED - Enable tag filtering (optional, default: false)" >&2
  echo "  DOCKER_CREDENTIAL_1PASSWORD_TAG_NAME - Tag name to filter by (required if tag filtering is enabled)" >&2
  exit 1
}

# Main function
function main() {
  # Check dependencies
  if ! check_dependencies; then
    exit 1
  fi
  
  # Validate environment variables
  if ! validate_environment; then
    exit 1
  fi

  # Check if argument is provided
  if [[ $# -eq 0 ]]; then
    usage
  fi

  # Process command
  case "$1" in
    list)
      list
      ;;
    get)
      get
      ;;
    store)
      store
      ;;
    erase)
      erase
      ;;
    *)
      echo "Error: unknown option $1" >&2
      usage
      ;;
  esac
}

# Execute main function
main "$@"
